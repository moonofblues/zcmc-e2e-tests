# Copy this file to .env and fill in. .env is git-ignored. Never commit real credentials.
BASE_URL=https://recruitment.zcmc.online

# Throwaway Mailinator address used by the full-registration test (public inbox: use only fake data).
TEST_EMAIL=zcmc.pwtest01@mailinator.com
TEST_PASSWORD=ChangeMe#2026!
TEST_MOBILE=09123456789

# Registration: a NEW email is needed for every full-registration run. Used by TC-REG-034 to test a duplicate.
TEST_EXISTING_EMAIL=

# Existing account used by the Portal Gateway tests (TC-LOGIN-009 to 014). Real credentials go in .env only.
TEST_LOGIN_EMAIL=
TEST_LOGIN_PASSWORD=

# Optional: an applicant-only account for TC-LOGIN-015
TEST_APPLICANT_ONLY_EMAIL=
TEST_APPLICANT_ONLY_PASSWORD=

# Admin / Staff Portal tests (TC-JP-*). The login has a Security Verification challenge that automation must not solve,
# so sign in by hand once and save the session:  npx playwright codegen --save-storage=admin-state.json https://recruitment.zcmc.online/login
# Then set the file path here. Without it the Job Posts tests skip.
ADMIN_STORAGE_STATE=
# Set to 1 to run the tests that create and delete a real "PW TEST" job post on the live site.
ALLOW_JOB_POST_WRITES=

# Application flow tests (TC-APPLY-*, TC-APPPORTAL-*, TC-APPADM-*) use the same ADMIN_STORAGE_STATE login: the account has an
# Admin Dashboard and an Applicant Portal module (user menu > Switch Module).
# Full journey TC-E2E-* (creates a REAL application on the live site; currently Blocked, see TODO.md):
RUN_APPLICATION_JOURNEY=
# Job title to apply for (default ATTORNEY I) and the email of the signed-in account (to find its row in HR admin).
E2E_JOB_TITLE=
E2E_APPLICANT_EMAIL=
